-- Creamos una tabla que actúa como diccionario de funciones
local operaciones = {
 -- Método 1: Usando una función anónima asignada a una clave
 sumar = function(a, b)
 return a + b
 end,
 
 restar = function(a, b)
 return a - b
 end
}
-- Método 2: Asignando funciones a la tabla después de declararla
operaciones["multiplicar"] = function(a, b)
 return a * b
end
